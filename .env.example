# ============================================================
# DukaanPilot - Environment Configuration
# ============================================================

# Server & Runtime
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# Authentication
JWT_SECRET=dukaanpilot-dev-super-secure-secret-2026-change-in-production
JWT_EXPIRES_IN=7d

# Database (Neon Serverless PostgreSQL or Local Postgres)
# Neon connection string format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# AI Model Provider (Model Abstraction Layer - Phase 5)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage & Logging Limits (Storage target <= 15 GB)
LOG_LEVEL=info
STORAGE_BUDGET_GB=15
