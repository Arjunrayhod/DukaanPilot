generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  CUSTOMER
  ADMIN
}

enum ShopCategory {
  KIRANA_GROCERY
  GENERAL_STORE
  TAILOR
  REPAIR_ELECTRONICS
  FRUITS_VEGETABLES
  DAIRY_SWEETS
  OTHER
}

model User {
  id           String     @id @default(uuid())
  phone        String     @unique
  name         String
  email        String?    @unique
  passwordHash String
  role         Role       @default(OWNER)
  pin          String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  ownedShops   Shop[]     @relation("ShopOwner")
  staffMember  Staff?
  auditLogs    AuditLog[]

  @@index([phone])
  @@index([role])
}

model Shop {
  id           String       @id @default(uuid())
  name         String
  ownerId      String
  category     ShopCategory @default(KIRANA_GROCERY)
  phone        String
  address      String?
  city         String?
  state        String?
  pincode      String?
  upiId        String?
  gstNumber    String?
  currency     String       @default("INR")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  owner        User         @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  staff        Staff[]
  auditLogs    AuditLog[]

  @@index([ownerId])
  @@index([phone])
}

model Staff {
  id          String   @id @default(uuid())
  userId      String   @unique
  shopId      String
  permissions String   @default("POS,ORDERS")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model AuditLog {
  id          String   @id @default(uuid())
  shopId      String?
  userId      String?
  action      String
  entity      String
  entityId    String?
  metadata    String?  // JSON stringified payload
  ipAddress   String?
  createdAt   DateTime @default(now())

  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
